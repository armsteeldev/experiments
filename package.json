{
  "name": "armsteel-experiments",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test:numerics": "node scripts/check-deep-zoom.mjs",
    "test:simulations": "node scripts/check-simulations.mjs",
    "test:adder": "node scripts/check-adder.mjs",
    "test:fern": "node scripts/check-fern.mjs",
    "test:attractors": "node scripts/check-attractor-trail.mjs",
    "test:invisible-world": "node scripts/check-invisible-world.mjs",
    "test:journeys": "node scripts/check-journeys.mjs",
    "test:buttons": "node scripts/check-button-styles.mjs",
    "test:storage": "node scripts/check-storage.mjs",
    "qa:existing": "node scripts/qa-existing-exhibits.mjs",
    "qa:resources": "node scripts/qa-invisible-resources.mjs",
    "qa:journeys": "node scripts/qa-journeys.mjs",
    "qa:saved-experiments": "node scripts/qa-saved-experiments.mjs",
    "qa:state-sharing": "node scripts/qa-state-sharing.mjs",
    "qa:exhibit-overlays": "node scripts/qa-exhibit-overlays.mjs",
    "qa:gallery-previews": "node scripts/qa-gallery-previews.mjs",
    "qa:collection-discovery": "node scripts/qa-collection-discovery.mjs",
    "qa:invisible-world": "node scripts/qa-invisible-world.mjs",
    "test": "npm run test:numerics && npm run test:simulations && npm run test:adder && npm run test:fern && npm run test:attractors && npm run test:invisible-world && npm run test:journeys && npm run test:buttons && npm run test:storage",
    "check:site": "node scripts/check-site-pages.mjs",
    "verify": "npm run build && npm test && npm run check:site",
    "preview": "vite preview --host 0.0.0.0",
    "publish": "bash deploy/publish.sh"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
